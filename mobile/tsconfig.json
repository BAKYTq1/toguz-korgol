{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../src/game/engine.ts",
    "../src/game/ai.ts",
    "../src/i18n/translations.ts",
    "../src/hooks/useMultiplayer.ts",
    "../src/lib/profile.ts"
  ]
}
