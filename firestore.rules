rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() &&
        (request.auth.uid == resource.data.player0 || request.auth.uid == resource.data.player1);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // The seat (0 or 1) of the signed-in player must match whose turn it is.
    function isMyTurn() {
      return (resource.data.player0 == request.auth.uid && resource.data.turn == 0) ||
        (resource.data.player1 == request.auth.uid && resource.data.turn == 1);
    }

    // A second player takes the free seat of a waiting room.
    function isClaimingSeat() {
      return resource.data.status == 'waiting' &&
        resource.data.player1 == null &&
        request.auth.uid != resource.data.player0 &&
        request.resource.data.player0 == resource.data.player0 &&
        request.resource.data.player1 == request.auth.uid &&
        request.resource.data.status == 'playing' &&
        request.resource.data.lastSeen1 == request.time &&
        changedOnly(['player1', 'name1', 'status', 'updatedAt', 'lastSeen1']);
    }

    function isHeartbeat() {
      return (resource.data.player0 == request.auth.uid &&
          changedOnly(['lastSeen0']) &&
          request.resource.data.lastSeen0 == request.time) ||
        (resource.data.player1 == request.auth.uid &&
          changedOnly(['lastSeen1']) &&
          request.resource.data.lastSeen1 == request.time);
    }

    function isLeaving() {
      return request.resource.data.status == 'closed' &&
        request.resource.data.closedBy == request.auth.uid &&
        changedOnly(['status', 'closedBy']);
    }

    function isGameEvent() {
      return resource.data.status == 'playing' &&
        request.resource.data.status == 'playing' &&
        request.resource.data.revision == resource.data.revision + 1 &&
        request.resource.data.event.from == request.auth.uid &&
        changedOnly(['turn', 'revision', 'event', 'updatedAt']) &&
        (
          (request.resource.data.event.type == 'restart' && request.resource.data.turn == 0) ||
          (request.resource.data.event.type == 'move' &&
            request.resource.data.event.idx >= 0 &&
            request.resource.data.event.idx <= 17 &&
            isMyTurn() &&
            request.resource.data.turn == 1 - resource.data.turn)
        );
    }

    match /rooms/{roomId} {
      // Authenticated clients need to discover waiting rooms for quick matchmaking.
      allow get, list: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.player0 == request.auth.uid &&
        request.resource.data.player1 == null &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.turn == 0 &&
        request.resource.data.revision == 0 &&
        request.resource.data.lastSeen0 == request.time;

      // Claim a seat, or (as a member) send a heartbeat, leave, or submit the next game event.
      allow update: if signedIn() &&
        (isClaimingSeat() || (isMember() && (isHeartbeat() || isLeaving() || isGameEvent())));

      // The searching player may cancel; old abandoned queue entries can be pruned.
      allow delete: if signedIn() && (
        resource.data.player0 == request.auth.uid ||
        (resource.data.status == 'waiting' &&
          resource.data.lastSeen0 < request.time - duration.value(75, 's'))
      );
    }

    function validStat(value) {
      return value is int && value >= 0 && value <= 100000;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'bio', 'stats', 'migratedGuestUids',
          'legacyStatsImported', 'createdAt', 'updatedAt']) &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 28 &&
        data.bio is string && data.bio.size() <= 160 &&
        data.stats is map && data.stats.keys().hasOnly(['wins', 'losses', 'draws']) &&
        validStat(data.stats.wins) && validStat(data.stats.losses) && validStat(data.stats.draws);
    }

    // ── Tournaments: public to follow by link, changed only by the organiser. ──
    function validTournament(d) {
      return d.keys().hasOnly(['name', 'game', 'format', 'plannedRounds', 'players', 'rounds',
          'status', 'ownerUid', 'classCode', 'createdAt', 'updatedAt']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
        d.game in ['toguz-korgool', 'mangala'] &&
        d.format in ['round-robin', 'swiss'] &&
        d.plannedRounds is int && d.plannedRounds >= 1 && d.plannedRounds <= 64 &&
        d.players is list && d.players.size() >= 2 && d.players.size() <= 64 &&
        d.rounds is list && d.rounds.size() <= 64 &&
        d.status in ['running', 'finished'] &&
        (d.classCode == null || (d.classCode is string && d.classCode.size() <= 12));
    }

    match /tournaments/{tournamentId} {
      // Open to anyone holding the (unguessable) link, but not listable: class tournaments
      // carry students' names. Organisers list only their own.
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        validTournament(request.resource.data);
      allow update: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validTournament(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ── School classes: the teacher owns the class and sees every student's progress. ──
    function validClass(d) {
      return d.keys().hasOnly(['name', 'teacherUid', 'teacherName', 'createdAt']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 60 &&
        d.teacherName is string && d.teacherName.size() <= 40;
    }

    function validStudent(d) {
      return d.keys().hasOnly(['name', 'lessons', 'puzzles', 'joinedAt', 'updatedAt']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 40 &&
        d.lessons is list && d.lessons.size() <= 200 &&
        d.puzzles is list && d.puzzles.size() <= 500;
    }

    match /classes/{code} {
      function isTeacher() {
        return get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
      }

      // Anyone signed in may open a class by its code (to join); only teachers list their own.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if signedIn() && code.size() == 6 &&
        request.resource.data.teacherUid == request.auth.uid &&
        validClass(request.resource.data);
      allow update: if signedIn() &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.teacherUid == request.auth.uid &&
        validClass(request.resource.data);
      allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;

      match /students/{studentUid} {
        allow read: if signedIn() && (request.auth.uid == studentUid || isTeacher());
        allow create: if signedIn() && request.auth.uid == studentUid &&
          exists(/databases/$(database)/documents/classes/$(code)) &&
          validStudent(request.resource.data);
        allow update: if signedIn() && request.auth.uid == studentUid && validStudent(request.resource.data);
        allow delete: if signedIn() && (request.auth.uid == studentUid || isTeacher());
      }
    }

    match /profiles/{userId} {
      // Each guest or registered player may read and update only their own profile.
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && validProfile(request.resource.data);
      allow delete: if false;
    }
  }
}
